# Next Level 环境变量示例
# 复制为 .env.local 后填写。真实密钥只通过服务端环境变量注入，
# 不要写进提示词、源码、前端、日志或 Git。所有变量留空时项目仍可跑完整 Demo，
# 此时 Provider 会以 mock / fallback 模式运行，界面上一律标注为演示数据。

# ---- 大模型 Provider ----
# 留空 => LLM 走 mock，岗位结构化、材料提取、面试问题与判词使用预置演示内容
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 可选：若接入供应商的实时 WebRTC/WebSocket 通道，在服务端配置地址；
# 未配置时，面试房间使用浏览器实时转写 + 服务端 LLM 分轮对话。
LLM_REALTIME_WS_URL=
LLM_REALTIME_MODEL=
LLM_REQUEST_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1

# ---- Next Level 业务持久化 ----
# 未填写时仅用于单实例 Demo；生产环境必须连接 PostgreSQL
DATABASE_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
SESSION_SECRET=
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# 私有对象存储，仅保存附件元数据与受控文件地址，不保存完整音频
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=next-level-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ---- 知乎官方能力 ----
# 知识列表与详情接口无需鉴权即可返回真实数据；
# 站内搜索需要 ZHIHU_ACCESS_SECRET，缺失时降级到 Demo Cache 并标注来源。
ZHIHU_APP_ID=
ZHIHU_APP_KEY=
ZHIHU_ACCESS_SECRET=
# 黑客松 OAuth：App Key 只在服务端交换 Token，不进入浏览器
ZHIHU_OAUTH_APP_ID=200
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/zhihu/callback
# 兼容通用命名；若上面已配置可留空
ZHIHU_OAUTH_CLIENT_ID=
ZHIHU_OAUTH_CLIENT_SECRET=

# 每自然日调用预算（按应用计），超出后不再发起真实请求，改用缓存
ZHIHU_DAILY_BUDGET=3
# 服务端缓存 TTL，默认 24 小时
ZHIHU_CACHE_TTL_SECONDS=86400
ZHIHU_REQUEST_TIMEOUT_MS=8000
# 单次调用最多重试一次
ZHIHU_MAX_RETRIES=1
# 连续失败多少次后打开熔断
ZHIHU_CIRCUIT_BREAKER_FAILURES=3
# 是否允许用户在成长报告页手动刷新
ZHIHU_MANUAL_REFRESH_ENABLED=true

# ---- A2A ----
# 进程内 JSON-RPC 传输层，可替换；协议适配边界保留在 src/lib/a2a/transport.ts
A2A_TRANSPORT=in-process-jsonrpc
